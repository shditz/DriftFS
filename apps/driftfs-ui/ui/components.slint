import { Theme } from "theme.slint";

export component Card inherits Rectangle {
    in property <length> inner-padding: 16px;
    in property <length> spacing: 12px;
    
    background: Theme.surface-card;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-lg;
    clip: true;

    VerticalLayout {
        padding: root.inner-padding;
        spacing: root.spacing;
        @children
    }
}

export component StatusBadge inherits Rectangle {
    in property <string> text: "Idle";
    in property <color> badge-color: Theme.success;
    in property <color> badge-bg: Theme.surface-subtle;

    background: root.badge-bg;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-sm;
    height: 24px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 9px;
        spacing: 6px;
        alignment: center;

        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.badge-color;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: Theme.text-primary;
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

export component MonoBadge inherits Rectangle {
    in property <string> text: "";
    in property <color> badge-color: Theme.text-secondary;

    background: Theme.surface-subtle;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-xs;
    height: 20px;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;

        Text {
            text: root.text;
            color: root.badge-color;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> text: "Continue";
    in property <bool> enabled: true;
    callback clicked();

    background: !root.enabled ? Theme.surface-subtle : (touch.pressed ? Theme.primary-pressed : (touch.has-hover ? Theme.primary-hover : Theme.primary));
    border-color: !root.enabled ? Theme.border-subtle : (touch.has-hover ? #ffffff : Theme.primary);
    border-width: 1px;
    border-radius: Theme.radius-md;
    height: 34px;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: !root.enabled ? Theme.text-dim : Theme.primary-text;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SecondaryButton inherits Rectangle {
    in property <string> text: "Cancel";
    in property <bool> enabled: true;
    callback clicked();

    background: !root.enabled ? Theme.surface-subtle : (touch.pressed ? Theme.surface-active : (touch.has-hover ? Theme.surface-hover : Theme.surface-card));
    border-color: touch.has-hover ? Theme.border-highlight : Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-md;
    height: 34px;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: !root.enabled ? Theme.text-dim : Theme.text-primary;
        font-size: 12px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component DangerButton inherits Rectangle {
    in property <string> text: "Delete";
    in property <bool> enabled: true;
    callback clicked();

    background: !root.enabled ? Theme.surface-subtle : (touch.pressed ? Theme.danger-bg : (touch.has-hover ? #321316 : Theme.danger-bg));
    border-color: !root.enabled ? Theme.border-subtle : (touch.has-hover ? #542226 : #3e1b1e);
    border-width: 1px;
    border-radius: Theme.radius-md;
    height: 34px;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: !root.enabled ? Theme.text-dim : #ff7b72;
        font-size: 12px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> progress: 0.0;
    in property <color> fill-color: Theme.text-primary;

    height: 5px;
    background: Theme.surface-input;
    border-color: Theme.border-subtle;
    border-width: 1px;
    border-radius: 3px;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width * Math.min(1.0, Math.max(0.0, root.progress));
        height: parent.height;
        background: root.fill-color;
        border-radius: 3px;
        animate width { duration: 200ms; easing: ease-out; }
    }
}

export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled();

    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? Theme.primary : Theme.surface-subtle;
    border-color: root.checked ? Theme.primary-hover : Theme.border;
    border-width: 1px;
    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.checked ? Theme.primary-text : Theme.text-muted;
        animate x { duration: 120ms; easing: ease-out; }
    }
}

export component VectorDiskIcon inherits Path {
    in property <color> icon-color: Theme.text-muted;
    width: 16px;
    height: 16px;
    stroke: root.icon-color;
    stroke-width: 1.5px;
    fill: transparent;
    commands: "M 3 6 L 21 6 C 21.5 6 22 6.5 22 7 L 22 17 C 22 17.5 21.5 18 21 18 L 3 18 C 2.5 18 2 17.5 2 17 L 2 7 C 2 6.5 2.5 6 3 6 Z M 2 13 L 22 13 M 17 15.5 L 17.01 15.5 M 14 15.5 L 14.01 15.5";
}

export component VectorLayersIcon inherits Path {
    in property <color> icon-color: Theme.text-muted;
    width: 16px;
    height: 16px;
    stroke: root.icon-color;
    stroke-width: 1.5px;
    fill: transparent;
    commands: "M 12 2 L 2 7 L 12 12 L 22 7 Z M 2 12 L 12 17 L 22 12 M 2 17 L 12 22 L 22 17";
}

export component VectorActivityIcon inherits Path {
    in property <color> icon-color: Theme.text-muted;
    width: 16px;
    height: 16px;
    stroke: root.icon-color;
    stroke-width: 1.5px;
    fill: transparent;
    commands: "M 2 12 L 6 12 L 9 4 L 15 20 L 18 12 L 22 12";
}

export component VectorSettingsIcon inherits Path {
    in property <color> icon-color: Theme.text-muted;
    width: 16px;
    height: 16px;
    stroke: root.icon-color;
    stroke-width: 1.5px;
    fill: transparent;
    commands: "M 4 21 L 4 14 M 4 10 L 4 3 M 12 21 L 12 12 M 12 8 L 12 3 M 20 21 L 20 16 M 20 12 L 20 3 M 1 14 L 7 14 M 9 8 L 15 8 M 17 16 L 23 16";
}

export component SidebarItem inherits Rectangle {
    in property <string> text: "Overview";
    in property <int> icon-index: 0;
    in property <bool> active: false;
    callback clicked();

    height: 36px;
    background: root.active ? Theme.surface-subtle : (touch.has-hover ? Theme.surface-hover : transparent);
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.active ? Theme.border : transparent;
    animate background { duration: 100ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        alignment: start;

        Rectangle {
            width: 16px;
            height: parent.height;

            if root.icon-index == 0: VectorDiskIcon {
                icon-color: root.active ? Theme.text-primary : Theme.text-muted;
                y: (parent.height - self.height) / 2;
            }
            if root.icon-index == 1: VectorLayersIcon {
                icon-color: root.active ? Theme.text-primary : Theme.text-muted;
                y: (parent.height - self.height) / 2;
            }
            if root.icon-index == 2: VectorActivityIcon {
                icon-color: root.active ? Theme.text-primary : Theme.text-muted;
                y: (parent.height - self.height) / 2;
            }
            if root.icon-index == 3: VectorSettingsIcon {
                icon-color: root.active ? Theme.text-primary : Theme.text-muted;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.text;
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            font-size: 13px;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
        }
    }
}

export component InputField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> text <=> input.text;
    in property <bool> enabled: true;

    height: 58px;

    VerticalLayout {
        spacing: 4px;
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 11px;
            font-weight: 500;
        }

        Rectangle {
            height: 36px;
            background: Theme.surface-input;
            border-color: input.has-focus ? Theme.border-focus : Theme.border;
            border-width: 1px;
            border-radius: Theme.radius-sm;
            animate border-color { duration: 100ms; }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;

                input := TextInput {
                    color: Theme.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                    enabled: root.enabled;
                }
            }

            if input.text == "" && !input.has-focus: Text {
                x: 10px;
                y: (parent.height - self.height) / 2;
                text: root.placeholder;
                color: Theme.text-dim;
                font-size: 12px;
            }
        }
    }
}
